<!-- TDfocus - la bulle du cockpit (au repos).
     Petite fenêtre ronde, sans bordure, toujours au-dessus des autres (Topmost).
     Fenêtre de 100 px : 84 px de bulle + 8 px autour pour l'ombre. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TDfocus - bulle Cockpit" Width="100" Height="100"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <!-- Un vrai bouton : lisible par un lecteur d'écran, activable au clavier. -->
    <!-- BorderBrush = couleur du contour : gris au repos, bleu quand le chrono d'un ticket tourne,
         couleur d'alerte quand ce ticket dépasse la limite (réglé par le code). -->
    <Button x:Name="BubbleButton" Width="84" Height="84" Cursor="Hand" BorderBrush="#3A3F4A"
            AutomationProperties.Name="Cockpit TDfocus : ouvrir"
            ToolTip="Tickets fermés aujourd'hui. Clic : ouvrir le cockpit. Glisser : déplacer la bulle.">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Disc" Fill="#1F2229" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
              </Ellipse.Effect>
            </Ellipse>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Survol ou clavier : le contour s'éclaircit, sans animation. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Stroke" Value="#9AA1AC"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Disc" Property="Stroke" Value="#E8EAED"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <StackPanel>
        <TextBlock x:Name="BubbleCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#5B9BF0"
                   HorizontalAlignment="Center" LineHeight="32" LineStackingStrategy="BlockLineHeight"/>
        <TextBlock x:Name="BubbleLabel" Text="fermés" FontSize="11" Foreground="#9AA1AC" HorizontalAlignment="Center"/>
      </StackPanel>
    </Button>
    <!-- Pastille orange : au moins une relance est due aujourd'hui. -->
    <Ellipse x:Name="BubbleDot" Width="20" Height="20" Fill="#F0A35B" Stroke="#16181D" StrokeThickness="3"
             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"
             Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Window>
