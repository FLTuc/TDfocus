<!-- TDfocus - le cockpit ouvert.
     Fenêtre sans bordure, toujours au-dessus des autres (Topmost), thème sombre fixe.
     Couleurs : fond #16181D, cartes #1F2229, texte #E8EAED, texte secondaire #9AA1AC,
     tickets #5B9BF0, projets #F0A35B, alerte #F28B82. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TDfocus - Cockpit" Width="420" Height="860"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Foreground="#E8EAED" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CkBg" Color="#16181D"/>
    <SolidColorBrush x:Key="CkCard" Color="#1F2229"/>
    <SolidColorBrush x:Key="CkText" Color="#E8EAED"/>
    <SolidColorBrush x:Key="CkMuted" Color="#9AA1AC"/>
    <SolidColorBrush x:Key="CkTickets" Color="#5B9BF0"/>
    <SolidColorBrush x:Key="CkProjects" Color="#F0A35B"/>
    <SolidColorBrush x:Key="CkAlert" Color="#F28B82"/>
    <SolidColorBrush x:Key="CkLine" Color="#2A2D35"/>
    <SolidColorBrush x:Key="CkButtonBg" Color="#2A2E37"/>
    <SolidColorBrush x:Key="CkRing" Color="#3A3F4A"/>

    <!-- Bouton : au moins 44 px, coins arrondis, contour visible au survol et au clavier. -->
    <Style x:Key="CkButton" TargetType="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Background" Value="{StaticResource CkButtonBg}"/>
      <Setter Property="Foreground" Value="{StaticResource CkText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3F4A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E8EAED"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tuile : un vrai bouton, sur le fond du cockpit. Son contour montre la tuile dont la liste est ouverte. -->
    <Style x:Key="CkTile" TargetType="Button">
      <Setter Property="MinHeight" Value="64"/>
      <Setter Property="Background" Value="{StaticResource CkBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource CkText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3F4A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E8EAED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Champ de saisie sombre : 44 px de haut, contour bleu quand on écrit dedans. -->
    <Style x:Key="CkField" TargetType="TextBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Background" Value="{StaticResource CkBg}"/>
      <Setter Property="Foreground" Value="{StaticResource CkText}"/>
      <Setter Property="CaretBrush" Value="{StaticResource CkText}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource CkTickets}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="#3A3F4A">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B9BF0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bascule « Urgent » : une coche et la couleur d'alerte quand elle est activée. -->
    <Style x:Key="CkToggle" TargetType="ToggleButton">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Background" Value="{StaticResource CkButtonBg}"/>
      <Setter Property="Foreground" Value="{StaticResource CkText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                <Path x:Name="Check" Data="M 0 5 L 4 9 L 11 1" Stroke="#16181D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource CkAlert}"/>
                <Setter Property="Foreground" Value="#16181D"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3F4A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E8EAED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Case à cocher de la checklist : une ligne d'au moins 44 px ; la case se remplit d'orange une fois cochée. -->
    <Style x:Key="CkCheck" TargetType="CheckBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Foreground" Value="{StaticResource CkText}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="2,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" BorderBrush="#9AA1AC" Background="Transparent" VerticalAlignment="Center">
                  <Path x:Name="Mark" Data="M 0 5 L 4 9 L 11 1" Stroke="#16181D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource CkProjects}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CkProjects}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="#E8EAED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Carte : bloc de contenu sur fond #1F2229. -->
    <Style x:Key="CkCardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CkCard}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Petit titre de carte, en majuscules. -->
    <Style x:Key="CkTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource CkMuted}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Barre de défilement fine et discrète (petits écrans). -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#3A3F4A" CornerRadius="4" Margin="1"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Le contour deviendra orange pendant un bloc projet (étape 6). -->
  <Border x:Name="PanelRoot" Background="{StaticResource CkBg}" BorderBrush="{StaticResource CkLine}" BorderThickness="2"
          CornerRadius="16" RenderOptions.ClearTypeHint="Enabled">
    <Grid Margin="14,10,14,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 1. En-tête : date et heure (on déplace le cockpit en le tenant ici) + « réduire en bulle ». -->
      <Grid x:Name="Header" Background="Transparent" ToolTip="Glisser pour déplacer le cockpit">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
          <TextBlock x:Name="DateText" Text="" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="TimeText" Text="" FontSize="15" Foreground="{StaticResource CkMuted}" Margin="6,0,0,0"/>
        </StackPanel>
        <Button x:Name="BtnReduce" Grid.Column="1" Style="{StaticResource CkButton}" Width="44" Height="44" Padding="0"
                Background="{StaticResource CkCard}" ToolTip="Réduire en bulle" AutomationProperties.Name="Réduire en bulle">
          <Path Data="M 0 0 L 6 6 L 12 0" Stroke="#9AA1AC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
      </Grid>

      <!-- Le reste défile si l'écran est trop petit pour 860 px de haut. -->
      <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Body">
          <!-- 2. Jauge « Équilibre du jour » : toujours en haut. Temps d'aujourd'hui, tickets en bleu, projets en orange. -->
          <Border x:Name="BalanceCard" Style="{StaticResource CkCardBox}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="ÉQUILIBRE DU JOUR" Style="{StaticResource CkTitle}" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="BalanceTarget" Text="objectif 60 / 40" FontSize="12" Foreground="{StaticResource CkMuted}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" ToolTip="Part visée : tickets / projets. Elle se règle dans TDfocus : Réglages, Confort."/>
              </Grid>
              <Grid Height="18">
                <Border Height="10" Background="{StaticResource CkLine}" CornerRadius="5" VerticalAlignment="Center"/>
                <!-- Les deux parts : le code règle la largeur des colonnes. -->
                <Grid x:Name="BalanceBar" Height="10" VerticalAlignment="Center" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BalanceTicketsCol" Width="1*"/>
                    <ColumnDefinition x:Name="BalanceProjectsCol" Width="1*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BalanceTicketsFill" Background="{StaticResource CkTickets}" CornerRadius="5,0,0,5"/>
                  <Border x:Name="BalanceProjectsFill" Grid.Column="1" Background="{StaticResource CkProjects}" CornerRadius="0,5,5,0"/>
                </Grid>
                <!-- Repère de l'objectif : un trait clair, placé par le code. -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BalanceMarkLeft" Width="60*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="BalanceMarkRight" Width="40*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="1" Width="3" Background="{StaticResource CkText}" CornerRadius="1.5"/>
                </Grid>
              </Grid>
              <Grid Margin="0,6,0,0">
                <TextBlock x:Name="BalanceTicketsText" Text="Tickets 0 min" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource CkTickets}"/>
                <TextBlock x:Name="BalanceProjectsText" Text="Projets 0 min" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource CkProjects}"
                           HorizontalAlignment="Right"/>
              </Grid>
              <!-- Phrase affichée seulement si un côté passe derrière. -->
              <TextBlock x:Name="BalanceMessage" Text="" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Bloc projet planifié dont l'heure est arrivée : une invitation, sans rien forcer. -->
          <Border x:Name="BlockBanner" Style="{StaticResource CkCardBox}" BorderBrush="{StaticResource CkProjects}" BorderThickness="2" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="BlockBannerTitle" Text="C'EST L'HEURE DU BLOC PROJET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CkProjects}"/>
                <TextBlock x:Name="BlockBannerText" Text="" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="BlockBannerSlot" Text="" FontSize="12" Foreground="{StaticResource CkMuted}"/>
              </StackPanel>
              <Button x:Name="BtnBlockStart" Grid.Column="1" Style="{StaticResource CkButton}" Content="Commencer" Margin="8,0,0,0"
                      Background="{StaticResource CkProjects}" Foreground="#16181D" ToolTip="Le bloc projet devient la tâche en cours de TDfocus"/>
            </Grid>
          </Border>

          <!-- Mode projet : affiché quand la tâche en cours de TDfocus est un bloc projet. -->
          <Border x:Name="ProjectModeCard" Style="{StaticResource CkCardBox}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="BlockSlot" Text="BLOC PROJET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CkProjects}"/>
              <TextBlock x:Name="BlockName" Text="" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="BlockRemaining" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource CkProjects}" Margin="0,2,0,0"/>
              <Grid Height="6" Margin="0,8,0,0">
                <Border Background="{StaticResource CkLine}" CornerRadius="3"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BlockBarDone" Width="0*"/>
                    <ColumnDefinition x:Name="BlockBarLeft" Width="1*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BlockBarFill" Background="{StaticResource CkProjects}" CornerRadius="3"/>
                </Grid>
              </Grid>
              <TextBlock Text="TÂCHE EN COURS" Style="{StaticResource CkTitle}" Margin="0,14,0,4"/>
              <TextBlock x:Name="BlockStep" Text="" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <!-- Checklist : les pas du bloc (remplie par le code). -->
              <StackPanel x:Name="BlockChecklist" Margin="0,6,0,0"/>
              <Border x:Name="BlockCrumbBox" Background="{StaticResource CkBg}" CornerRadius="10" Padding="12,10" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap"><Run Text="Où j'en étais : " FontWeight="SemiBold" Foreground="{StaticResource CkProjects}"/><Run x:Name="BlockCrumb" Text=""/></TextBlock>
              </Border>
              <!-- Note de reprise : ouverte par « Interrompre ». -->
              <StackPanel x:Name="BlockNoteForm" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="Note de reprise : où t'arrêtes-tu, et que voulais-tu faire ensuite ?" Foreground="{StaticResource CkMuted}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox x:Name="BlockNoteBox" Style="{StaticResource CkField}" MaxLength="300" AutomationProperties.Name="Note de reprise du projet"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnNoteSkip" Style="{StaticResource CkButton}" Content="Sans note" Padding="4,0"/>
                  <Button x:Name="BtnNoteSave" Grid.Column="2" Style="{StaticResource CkButton}" Content="Enregistrer la note" Padding="4,0"
                          Background="{StaticResource CkProjects}" Foreground="#16181D"/>
                </Grid>
              </StackPanel>
              <Grid x:Name="BlockButtons" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBlockToggle" Style="{StaticResource CkButton}" Content="Pause" Padding="4,0"/>
                <Button x:Name="BtnBlockStep" Grid.Column="2" Style="{StaticResource CkButton}" Content="Étape faite" Padding="4,0"
                        Background="{StaticResource CkProjects}" Foreground="#16181D"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Pendant un bloc projet, les tickets tiennent en UNE ligne. -->
          <Border x:Name="TicketsLine" Style="{StaticResource CkCardBox}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="15"><Run Text="Tickets" FontWeight="SemiBold" Foreground="{StaticResource CkTickets}"/><Run x:Name="TicketsLineText" Text=""/><Run x:Name="TicketsLineUrgent" Text="" Foreground="{StaticResource CkAlert}"/></TextBlock>
              <Button x:Name="BtnInterrupt" Grid.Column="1" Style="{StaticResource CkButton}" Content="Interrompre" Margin="8,0,0,0"
                      ToolTip="Met le bloc projet en pause, ouvre la note de reprise et montre les tickets"/>
            </Grid>
          </Border>

          <!-- 3. Tickets : les actions de la liste TDfocus (sauf blocs projet et pauses). -->
          <Border x:Name="TicketsCard" Style="{StaticResource CkCardBox}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="TICKETS" Style="{StaticResource CkTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button x:Name="BtnAddTicket" Style="{StaticResource CkButton}" HorizontalAlignment="Right" Content="+ Ticket"
                        ToolTip="Ajouter une action à ta liste TDfocus" AutomationProperties.Name="Ajouter un ticket à la liste TDfocus"/>
              </Grid>

              <!-- Formulaire d'ajout : replié tant qu'on n'a pas cliqué « + Ticket ». -->
              <StackPanel x:Name="AddForm" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid>
                  <TextBox x:Name="TicketBox" Style="{StaticResource CkField}" MaxLength="120" AutomationProperties.Name="Action à ajouter à la liste TDfocus"
                           ToolTip="Même saisie que dans TDfocus : un titre, une durée en minutes si tu veux. L'action rejoint ta liste TDfocus."/>
                  <TextBlock x:Name="TicketBoxHint" Text="ex. « INC-4821 VPN 20 », puis Entrée" Foreground="{StaticResource CkMuted}"
                             Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="TicketUrgent" Style="{StaticResource CkToggle}" Content="Urgent" ToolTip="Ce ticket passera avant les autres"/>
                  <Button x:Name="BtnAddCancel" Grid.Column="2" Style="{StaticResource CkButton}" Content="Annuler" Margin="0,0,8,0"/>
                  <Button x:Name="BtnAddConfirm" Grid.Column="3" Style="{StaticResource CkButton}" Content="Ajouter"
                          Background="{StaticResource CkTickets}" Foreground="#16181D"/>
                </Grid>
              </StackPanel>

              <!-- Trois tuiles. Un clic sur une tuile ouvre (ou referme) la liste de ses tickets. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TileOpen" Style="{StaticResource CkTile}" ToolTip="Actions de ta liste TDfocus (sauf blocs projet et pauses) : cliquer pour voir la liste">
                  <StackPanel>
                    <TextBlock x:Name="TileOpenCount" Text="0" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                               LineHeight="30" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource CkMuted}" HorizontalAlignment="Center"><Run x:Name="TileOpenLabel" Text="ouvert"/><Run x:Name="TileOpenUrgent" Text="" Foreground="{StaticResource CkAlert}"/></TextBlock>
                  </StackPanel>
                </Button>
                <Button x:Name="TileClosed" Grid.Column="2" Style="{StaticResource CkTile}" ToolTip="Tickets fermés aujourd'hui : cliquer pour voir la liste">
                  <StackPanel>
                    <TextBlock x:Name="TileClosedCount" Text="0" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                               LineHeight="30" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock x:Name="TileClosedLabel" Text="fermé aujourd'hui" FontSize="11" Foreground="{StaticResource CkMuted}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Grid Grid.Column="4">
                  <Button x:Name="TileWaiting" Style="{StaticResource CkTile}"
                          ToolTip="Tickets escaladés, en attente de quelqu'un. Pastille orange : une relance est à faire aujourd'hui.">
                    <StackPanel>
                      <TextBlock x:Name="TileWaitingCount" Text="0" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                                 LineHeight="30" LineStackingStrategy="BlockLineHeight"/>
                      <TextBlock Text="à relancer" FontSize="11" Foreground="{StaticResource CkMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <!-- Même pastille que sur la bulle : une relance est due. -->
                  <Ellipse x:Name="TileWaitingDot" Width="10" Height="10" Fill="{StaticResource CkProjects}" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
              </Grid>

              <!-- Liste des tickets de la tuile choisie (remplie par le code). -->
              <Border x:Name="TicketListBox" Visibility="Collapsed" Background="{StaticResource CkBg}" CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock x:Name="TicketListTitle" Text="" Style="{StaticResource CkTitle}" Margin="0"/>
                  <StackPanel x:Name="TicketList"/>
                </StackPanel>
              </Border>

              <!-- Ticket en cours : libellé, chrono, barre vers la limite, trois boutons. -->
              <StackPanel x:Name="CurrentBox" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="CurrentRef" Text="" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <Border x:Name="CurrentUrgent" Grid.Column="1" Background="{StaticResource CkAlert}" CornerRadius="6" Padding="7,2" Margin="8,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="URGENT" FontSize="10" FontWeight="Bold" Foreground="#16181D"/>
                  </Border>
                  <Border x:Name="CurrentWaiting" Grid.Column="2" Background="{StaticResource CkProjects}" CornerRadius="6" Padding="7,2" Margin="8,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="À RELANCER" FontSize="10" FontWeight="Bold" Foreground="#16181D"/>
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock x:Name="CurrentChrono" Text="00:00" FontSize="28" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
                  <TextBlock x:Name="CurrentLimit" Text="sur 30 min" Foreground="{StaticResource CkMuted}" Margin="10,0,0,5" VerticalAlignment="Bottom"/>
                </StackPanel>
                <!-- Barre de progression : deux colonnes dont le code règle les proportions. -->
                <Grid Height="6" Margin="0,6,0,0">
                  <Border Background="{StaticResource CkLine}" CornerRadius="3"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="BarDone" Width="0*"/>
                      <ColumnDefinition x:Name="BarLeft" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BarFill" Background="{StaticResource CkTickets}" CornerRadius="3"/>
                  </Grid>
                </Grid>
                <!-- Alerte fixe (pas de clignotement) quand la limite est dépassée. -->
                <TextBlock x:Name="CurrentAlert" Text="" Foreground="{StaticResource CkAlert}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnTicketToggle" Style="{StaticResource CkButton}" Content="Démarrer" Padding="4,0"/>
                  <Button x:Name="BtnTicketEscalate" Grid.Column="2" Style="{StaticResource CkButton}" Content="Escalader" Padding="4,0"
                          ToolTip="Le ticket attend quelqu'un d'autre : il passe dans « à relancer »"/>
                  <Button x:Name="BtnTicketClose" Grid.Column="4" Style="{StaticResource CkButton}" Content="Fermer" Padding="4,0"
                          ToolTip="Ticket résolu : il compte dans « fermés aujourd'hui »"/>
                </Grid>
              </StackPanel>
              <TextBlock x:Name="NoTicketText" Text="Aucune action en cours. Note-la dans TDfocus, ou « + Ticket »." Foreground="{StaticResource CkMuted}"
                         TextWrapping="Wrap" Margin="0,12,0,2"/>

              <!-- Ce qui vient de se passer, avec « Annuler » pendant quelques secondes. -->
              <Grid x:Name="TicketMessage" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TicketMessageText" Text="" Foreground="{StaticResource CkMuted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="BtnTicketUndo" Grid.Column="1" Style="{StaticResource CkButton}" Content="Annuler" Margin="8,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 4. Projets : lus dans le panneau Projets de TDfocus. -->
          <Border x:Name="ProjectsCard" Style="{StaticResource CkCardBox}">
            <StackPanel>
              <Grid Margin="0,0,0,2">
                <TextBlock x:Name="ProjectsTitle" Text="PROJETS" Style="{StaticResource CkTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button x:Name="BtnProjectsManage" Style="{StaticResource CkButton}" HorizontalAlignment="Right" Content="Gérer"
                        ToolTip="Ouvrir le panneau Projets de TDfocus : pas, échéance, blocage, bloc à planifier"/>
              </Grid>
              <StackPanel x:Name="ProjectList"/>
              <TextBlock x:Name="ProjectsEmpty" Text="Aucun projet en cours. Crée-le dans TDfocus (bouton Projets)." Foreground="{StaticResource CkMuted}"
                         TextWrapping="Wrap" Margin="0,6,0,2" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- 5. Relances du jour (tickets et projets mélangés) et prochaine réunion. -->
          <Border x:Name="FollowCard" Style="{StaticResource CkCardBox}">
            <StackPanel>
              <TextBlock Text="RELANCES DU JOUR" Style="{StaticResource CkTitle}" Margin="0,0,0,4"/>
              <StackPanel x:Name="FollowList"/>
              <TextBlock x:Name="FollowEmpty" Text="Aucune relance à faire aujourd'hui." Foreground="{StaticResource CkMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <Border Height="1" Background="{StaticResource CkLine}" Margin="0,10,0,10"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource CkMuted}"><Run x:Name="MeetingLabel" Text="Prochaine réunion : "/><Run x:Name="MeetingWhat" Text="" FontWeight="SemiBold" Foreground="{StaticResource CkText}"/><Run x:Name="MeetingDelay" Text=""/></TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- « Où j'en étais » et « Récap du jour » : un panneau qui recouvre le contenu, le temps de lire. -->
      <Border x:Name="InfoOverlay" Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource CkBg}" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <Border Style="{StaticResource CkCardBox}" VerticalAlignment="Top">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <TextBlock x:Name="InfoTitle" Text="" Style="{StaticResource CkTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button x:Name="BtnInfoClose" Style="{StaticResource CkButton}" HorizontalAlignment="Right" Content="Fermer"/>
              </Grid>
              <StackPanel x:Name="InfoList"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>

      <!-- 6. Boutons du bas, toujours visibles. -->
      <Grid Grid.Row="2" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnWhere" Style="{StaticResource CkButton}" Content="Où j'en étais" Background="{StaticResource CkCard}"
                ToolTip="Retrouver le fil : la tâche en cours, son étape, sa note, et la note de reprise de chaque projet"/>
        <Button x:Name="BtnRecap" Grid.Column="2" Style="{StaticResource CkButton}" Content="Récap du jour" Background="{StaticResource CkCard}"
                ToolTip="Ce qui est fait aujourd'hui, le temps passé, ce qui attend"/>
      </Grid>
    </Grid>
  </Border>
</Window>
