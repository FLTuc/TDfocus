<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TDfocus" Width="1080" Height="780" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Couleurs : remplacées à l'exécution par le thème clair ou sombre -->
    <SolidColorBrush x:Key="BgBrush" Color="#F6F4FB"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFECF7"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E4E0EE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#2E2A3B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6F6982"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7464CC"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7E3FA"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7CC9A5"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF3E9"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#12301F"/>
    <SolidColorBrush x:Key="OvertimeBrush" Color="#D99A55"/>
    <SolidColorBrush x:Key="OvertimeSoftBrush" Color="#FBEBD9"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E9E5F3"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#142E2A3B"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#1A2E2A3B"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="EmojiFont">Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Boutons -->
    <ControlTemplate x:Key="PillTemplate" TargetType="ButtonBase">
      <Grid>
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999"/>
        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="999" Opacity="0"/>
        <Border x:Name="Focus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="999" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SoftTemplate" TargetType="ButtonBase">
      <Grid>
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"/>
        <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="14" Opacity="0"/>
        <Border x:Name="Focus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="14" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource PillTemplate}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,10"/>
    </Style>
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,10"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
    </Style>
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource SoftTemplate}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Pastilles à sélection (durées, catégories, options) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Template" Value="{StaticResource PillTemplate}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent" LastChildFill="True">
              <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" Margin="12,0,0,0">
                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource SurfaceBrush}" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbShift" X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbShift" Property="X" Value="18"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Champs de saisie -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecretField" TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Textes -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,18,0,8"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Barre de défilement fine -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource LineBrush}" CornerRadius="4" Margin="1"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="0"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <!-- ===================== VUE COMPLÈTE ===================== -->
    <Grid x:Name="MainRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- En-tête : horloge, heure de fin, actions de surface -->
      <Grid x:Name="HeaderBar" Grid.Row="0" Margin="24,16,16,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="TDfocus" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="ClockText" Text="09:41" Margin="18,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" ToolTip="Heure actuelle"/>
        </StackPanel>
        <Border x:Name="EndPill" Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="16,7" Margin="12,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="EndLabel" Text="Fin de la liste" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="EndTime" Text="—" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="16" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <Border x:Name="DriftBadge" Margin="10,0,0,0" CornerRadius="999" Padding="8,1" Background="{DynamicResource OvertimeSoftBrush}" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock x:Name="DriftText" Text="+5 min" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OvertimeBrush}"/>
            </Border>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnSounds" Style="{StaticResource IconButton}" Content="&#xE7F6;" ToolTip="Sons et carillons"/>
          <Button x:Name="BtnTemplates" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Routines"/>
          <Button x:Name="BtnNotes" Style="{StaticResource IconButton}" Content="&#xE70B;" ToolTip="Bloc-notes (parking à idées)"/>
          <Button x:Name="BtnStats" Style="{StaticResource IconButton}" Content="&#xE9D9;" ToolTip="Statistiques : estimé vs réel"/>
          <Button x:Name="BtnImport" Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Importer (Agenda, Todoist, Notion, texte)"/>
          <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Réglages"/>
          <Border Width="1" Height="20" Background="{DynamicResource LineBrush}" Margin="6,0"/>
          <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="Thème clair / sombre"/>
          <Button x:Name="BtnFocusMode" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Mode focus (F)"/>
          <Button x:Name="BtnCompact" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Mode compact flottant (M)"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne principale -->
        <Grid x:Name="MainColumn" Margin="24,8,24,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Carte de la tâche en cours -->
          <Border x:Name="FocusCard" Grid.Row="0" Style="{StaticResource Card}" Padding="26,22" AllowDrop="True">
            <Grid>
              <!-- Tâche active -->
              <Grid x:Name="FocusActive">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="RingColumn" Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="RingHost" Width="210" Height="210" Margin="0,0,28,0" VerticalAlignment="Center">
                  <Ellipse x:Name="RingTrack" Stroke="{DynamicResource TrackBrush}" StrokeThickness="12"/>
                  <Path x:Name="RingArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="25:00" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="50" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="TimerSub" Text="restant" Foreground="{DynamicResource MutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="FocusDetails" Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border x:Name="CurrentCategory" CornerRadius="999" Padding="10,3" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,8,0">
                      <TextBlock x:Name="CurrentCategoryText" Text="Travail" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="CurrentState" Text="En pause" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="CurrentTitle" Text="Tâche" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <TextBlock x:Name="CurrentMeta" Text="" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,4"/>
                  <TextBlock x:Name="OvertimeHint" Text="" Foreground="{DynamicResource OvertimeBrush}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
                  <TextBlock x:Name="NextLine" Text="" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,4"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="BtnMinus5" Style="{StaticResource PillButton}" Content="−5" ToolTip="Retirer 5 minutes" Margin="0,0,6,8" Width="46"/>
                    <Button x:Name="BtnMinus1" Style="{StaticResource PillButton}" Content="−1" ToolTip="Retirer 1 minute (−)" Margin="0,0,10,8" Width="46"/>
                    <Button x:Name="BtnStartPause" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Démarrer / pause (Espace)" MinWidth="132">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartPauseIcon" Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StartPauseText" Text="Démarrer" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnDone" Style="{StaticResource SuccessButton}" Margin="0,0,10,8" ToolTip="Valider la tâche (Ctrl + Entrée)">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Terminé" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnPlus1" Style="{StaticResource PillButton}" Content="+1" ToolTip="Ajouter 1 minute (+)" Margin="0,0,6,8" Width="46"/>
                    <Button x:Name="BtnPlus5" Style="{StaticResource PillButton}" Content="+5" ToolTip="Ajouter 5 minutes" Margin="0,0,6,8" Width="46"/>
                  </WrapPanel>
                  <WrapPanel>
                    <Button x:Name="BtnTimerMode" Style="{StaticResource GhostButton}" ToolTip="Basculer décompte / compte progressif">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TimerModeText" Text="Décompte" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnLater" Style="{StaticResource GhostButton}" ToolTip="Reporter en fin de liste, sans culpabiliser (L)">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Plus tard" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnTaskNote" Style="{StaticResource GhostButton}" ToolTip="Note sur cette tâche">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TaskNoteText" Text="Note" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
                <TextBox x:Name="TaskNoteBox" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Field}" Margin="0,14,0,0" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Visibility="Collapsed" ToolTip="Notes de la tâche : enregistrées automatiquement"/>
              </Grid>

              <!-- État vide / liste terminée -->
              <StackPanel x:Name="FocusEmpty" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,18">
                <TextBlock x:Name="EmptyEmoji" Text="🌱" FontFamily="{StaticResource EmojiFont}" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="Qu'est-ce qui compte maintenant ?" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyText" Text="Ajoute une première tâche avec sa durée, ou charge une routine. Une seule chose à la fois." Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460"/>
                <Button x:Name="BtnEmptyTemplates" Style="{StaticResource PillButton}" Content="Charger une routine" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Saisie rapide -->
          <Border x:Name="AddBar" Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="NewTaskBox" Style="{StaticResource Field}" FontSize="15"/>
                  <TextBlock x:Name="NewTaskPlaceholder" Text="Ajouter une tâche…  ex. « Emails 15 » ou « Réunion 30 min @14h »" Foreground="{DynamicResource MutedBrush}" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Button x:Name="BtnAdd" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="18,9" ToolTip="Ajouter (Entrée)">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Ajouter" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
                <WrapPanel x:Name="DurationChips" VerticalAlignment="Center"/>
                <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="4,0,10,6" VerticalAlignment="Center"/>
                <WrapPanel x:Name="CategoryChips" VerticalAlignment="Center"/>
                <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="4,0,10,6" VerticalAlignment="Center"/>
                <Grid Width="104" Margin="0,0,0,6" VerticalAlignment="Center" ToolTip="Créneau figé (heure fixe), ex. 14:30 — laisser vide pour une tâche flottante">
                  <TextBox x:Name="FixedTimeBox" Style="{StaticResource Field}" Padding="30,5,8,5" FontSize="13"/>
                  <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/>
                  <TextBlock x:Name="FixedTimePlaceholder" Text="hh:mm" Foreground="{DynamicResource MutedBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"/>
                </Grid>
              </WrapPanel>
              <TextBlock x:Name="EstimateHint" Style="{StaticResource Muted}" Margin="2,2,0,0" Visibility="Collapsed" Cursor="Hand" ToolTip="Cliquer pour utiliser cette durée"/>
            </StackPanel>
          </Border>

          <!-- File d'attente + terminées -->
          <ScrollViewer x:Name="ListScroll" Grid.Row="2" Margin="0,6,-12,0" Padding="0,0,12,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid Margin="0,14,0,8">
                <TextBlock x:Name="UpNextHeader" Text="ENSUITE" Style="{StaticResource SectionLabel}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnSaveAsTemplate" Style="{StaticResource GhostButton}" Content="Enregistrer comme routine" FontSize="12"/>
                  <Button x:Name="BtnClearList" Style="{StaticResource GhostButton}" Content="Tout effacer" FontSize="12"/>
                </StackPanel>
              </Grid>
              <StackPanel x:Name="UpNextList"/>
              <TextBlock x:Name="UpNextEmpty" Text="Rien d'autre pour l'instant. C'est très bien comme ça." Style="{StaticResource Muted}" Margin="4,4,0,0"/>
              <Button x:Name="BtnDoneToggle" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-6,18,0,4" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="DoneChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="DoneHeader" Text="TERMINÉ AUJOURD'HUI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel x:Name="DoneList"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Panneau latéral (sons, routines, notes, stats, import, réglages) -->
        <Border x:Name="Drawer" Grid.Column="1" Width="380" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,16,12,4">
              <TextBlock x:Name="DrawerTitle" Text="Panneau" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="BtnDrawerClose" Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" ToolTip="Fermer (Échap)"/>
            </Grid>
            <ScrollViewer x:Name="DrawerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,0,22,24">
              <ContentControl x:Name="DrawerContent" Focusable="False"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== MODE COMPACT FLOTTANT ===================== -->
    <Border x:Name="CompactRoot" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" Padding="12,8" Cursor="SizeAll">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="54" Height="54" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="5"/>
          <Path x:Name="CompactArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="CompactTitle" Text="Tâche" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CompactTimer" Text="25:00" FontFamily="{StaticResource DisplayFont}" FontSize="22" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="CompactMeta" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,0,0,3" VerticalAlignment="Bottom"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
          <Button x:Name="CompactStartPause" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{DynamicResource AccentBrush}" ToolTip="Démarrer / pause"/>
          <Button x:Name="CompactDone" Style="{StaticResource IconButton}" Content="&#xE73E;" Foreground="{DynamicResource SuccessTextBrush}" Background="{DynamicResource SuccessSoftBrush}" ToolTip="Terminé" Margin="4,0"/>
          <Button x:Name="CompactExpand" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Revenir à la vue complète"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Confettis (au-dessus de tout, ne capte pas la souris) -->
    <Canvas x:Name="ConfettiLayer" IsHitTestVisible="False" ClipToBounds="True"/>

    <!-- Message éphémère avec annulation -->
    <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Background="{DynamicResource TextBrush}" CornerRadius="999" Padding="18,8,8,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastText" Text="Tâche terminée" Foreground="{DynamicResource BgBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="ToastAction" Style="{StaticResource PillButton}" Content="Annuler" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Padding="12,4" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
